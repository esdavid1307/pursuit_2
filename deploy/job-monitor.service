[Unit]
Description=Canadian internship ATS monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__/job-monitor
ExecStart=__REPO__/job-monitor/.venv/bin/python -u main.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
