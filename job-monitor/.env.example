# Discord webhook that receives new-job alerts (required for notifications)
DISCORD_WEBHOOK_URL=

# Paths (defaults shown; relative paths resolve against this directory)
#COMPANIES_JSON=../companies.json
#DATABASE_PATH=jobs.db

# Polling cadence
#HIGH_PRIORITY_INTERVAL_MINUTES=5
#NORMAL_PRIORITY_INTERVAL_MINUTES=30
#SCHEDULER_WAKE_SECONDS=60
#MAX_WORKERS=8
#REQUEST_TIMEOUT_SECONDS=15

# Only alert for jobs whose location matches Canada (blank/ambiguous locations are dropped)
#CANADA_ONLY=true

# Alert for jobs that already exist the first time a board is scanned
#SEND_EXISTING_ON_FIRST_RUN=false
