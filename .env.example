# ── catalog (data miner) ─────────────────────────────────────────────
# Optional. Public repositories work without a token.
GITHUB_TOKEN=

# ── monitor (Discord alerts) ─────────────────────────────────────────
# Webhook that receives Canadian job alerts (required for notifications)
DISCORD_WEBHOOK_URL=
# Optional second webhook: US-located matches are alerted to this channel instead
#DISCORD_WEBHOOK_URL_USA=

# Alert a newly discovered company's existing jobs on its first scan
#SEND_EXISTING_ON_FIRST_RUN=false
#USA_SEND_EXISTING_ON_FIRST_RUN=false

# Paths (defaults shown; relative paths resolve against the repo root)
#COMPANIES_JSON=data/companies.json
#DATABASE_PATH=data/jobs.db

# Polling cadence
#HIGH_PRIORITY_INTERVAL_MINUTES=5
#NORMAL_PRIORITY_INTERVAL_MINUTES=30
#SCHEDULER_WAKE_SECONDS=60
#MAX_WORKERS=8
#REQUEST_TIMEOUT_SECONDS=15

# Only alert for jobs whose location matches Canada or (with the USA
# webhook set) the United States; blank/ambiguous locations are dropped
#CANADA_ONLY=true
